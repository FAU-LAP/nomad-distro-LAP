# Keep local-only content out of the Docker build context. The .git directory
# must stay in the context: the Dockerfile mounts it for the version number.

# Credentials, certificates and transient local output never belong in an image.
.env
.env.*
tls/
.volumes/
.run-logs/

# Local virtual environments and a local NOMAD GUI checkout are not build input.
.venv*/
nomad-gui/
